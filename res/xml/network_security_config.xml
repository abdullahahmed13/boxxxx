<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ocsp.digicert.com</domain>
        <domain includeSubdomains="true">ocsp1.digicert.com</domain>
        <domain includeSubdomains="true">ocsp2.digicert.com</domain>
        <domain includeSubdomains="true">ocspx.digicert.com</domain>
        <domain includeSubdomains="true">ocsp.edge.digicert.com</domain>
        <domain includeSubdomains="true">ocsp.godaddy.com</domain>
        <domain includeSubdomains="true">o.lencr.org</domain>
        <domain includeSubdomains="true">crl3.digicert.com</domain>
        <domain includeSubdomains="true">crl4.digicert.com</domain>
        <domain includeSubdomains="true">crl.edge.digicert.com</domain>
        <domain includeSubdomains="true">crl.godaddy.com</domain>
        <domain includeSubdomains="true">c.lencr.org</domain>
    </domain-config>
</network-security-config>
